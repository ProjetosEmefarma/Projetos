{
    "name": "app/controle-brindes",
    "description": "Sistema de Controle de Brindes",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^2.2",
        "phpmailer/phpmailer": "^6.9",
        "ifsnop/mysqldump-php": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
        "config": {
            "platform": {
                "php": "8.2.0"
            },
            "platform-check": false,
            "optimize-autoloader": true,
            "sort-packages": true
        },
    "minimum-stability": "stable",
    "prefer-stable": true
}
